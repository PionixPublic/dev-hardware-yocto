[Unit]
Description=Make the booted RAUC slot permanent and mark it good
# The upstream rauc-mark-good.service never runs here, its
# ConditionKernelCommandLine needs rauc.slot= or bootchooser.active, which our
# cmdline.txt does not have. Until this has run, tryboot.txt is still pending
# and the next normal reboot falls back to the previous slot.
After=multi-user.target rauc.service rauc-init.service everest.service display-app.service

[Service]
Type=oneshot
# Only commit a slot that came up healthy, otherwise keep the tryboot fallback.
# everest and display-app use Restart=always, so a crash loop never shows up as
# "failed"; the gate waits (bounded) for both to be up and stable instead.
Environment=HEALTH_GATE_TIMEOUT=300 HEALTH_GATE_SETTLE=20 HEALTH_GATE_MAX_RESTARTS=3
TimeoutStartSec=420
ExecCondition=/usr/bin/belaybox-health-gate.sh
ExecStart=/usr/bin/check_system_health.sh
ExecStart=/usr/bin/rauc status mark-good
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
