[Unit]
Description=PionixDisplayApp
Requires=mosquitto.service
Requires=network.target
After=mosquitto.service
After=network.target

[Service]
Type=simple
Restart=always
User=root
LimitCORE=infinity
WorkingDirectory=/usr/bin
ExecStart=flutter-pi --release /usr/share/flutter/display_app/app

[Install]
WantedBy=multi-user.target
