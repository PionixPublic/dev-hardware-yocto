Subject: [PATCH] TabBarTheme should be TabBarThemeData

Signed-off-by: Kai-Uwe Hermann <kai-uwe.hermann@pionix.de>
---
 lib/theme/pionix_theme_provider.dart | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/theme/pionix_theme_provider.dart b/lib/theme/pionix_theme_provider.dart
index 91818d2..a10919c 100644
--- a/lib/theme/pionix_theme_provider.dart
+++ b/lib/theme/pionix_theme_provider.dart
@@ -158,7 +158,7 @@ class PionixThemeProvider {
         space: 6,
         thickness: 2,
       ),
-      tabBarTheme: TabBarTheme(
+      tabBarTheme: TabBarThemeData(
         overlayColor:
             WidgetStateProperty.resolveWith((states) => Colors.transparent),
         labelColor: scheme.onPrimary,
